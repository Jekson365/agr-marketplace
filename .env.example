# The farm API this app reads its listings from. Baked into the bundle at build time, so a build
# made without it falls back to the local server below.
VITE_API_URL=http://localhost:5261

# The farm management software, for the button an account with access to it is shown. Same idea:
# baked in at build time, defaulting to the SPA's own dev port.
VITE_FARM_APP_URL=http://localhost:5173
